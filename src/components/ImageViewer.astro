---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "@fancyapps/ui/dist/fancybox/fancybox.compactmode.css";
---

<script>
    import { Fancybox } from "@fancyapps/ui/dist/fancybox/fancybox.js";
    import { Compactmode } from "@fancyapps/ui/dist/fancybox/fancybox.compactmode.js";

    let imgs = document.querySelector("main #content").querySelectorAll("img");
    let els = Object.values(imgs).filter(el => !el.parentElement?.classList.contains('rlc-image-container') && !el.classList.contains('rlc-favicon')).filter(el => el.width > 100);
    els.forEach(e => e.dataset.caption = e.alt);
    els.forEach((e, i) => e.addEventListener("click", () => {
        Fancybox.fromNodes(els, {
            Carousel: {
                transition: "slide"
            },
            plugins: { Compactmode },
            startIndex: i
        })
    }))
</script>

<style is:inline>
    .fancybox__container {
        position: fixed;

        * {
            font-family: var(--font);
        }
    }
</style>
