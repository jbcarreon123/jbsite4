<style is:inline>
    .floating-window {
        display: flex;
        flex-direction: column;
        position: fixed;
        top: var(--top, 0);
        left: var(--left, 0);
        min-width: 350px;
        z-index: 998;
        transition: none !important;
        border: 1px solid var(--link-hover);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-width: calc(100dvw - 2px);
    }

    .floating-window.focused {
        border: 1px solid var(--link);
        z-index: 999;
    }

    .floating-window .floating-window-titlebar {
        display: flex;
        flex-direction: row;
        background-color: var(--acc);
        padding: 0 6px;
    }

    .floating-window .floating-window-titlebar p:first-child {
        flex-grow: 1;
    }

    .floating-window .floating-window-titlebar p {
        cursor: pointer;
    }

    .floating-window .floating-window-content {
        display: flex;
        flex-direction: column;
        min-height: 200px;
        background-color: var(--bg);
        padding: 6px;
        overflow: auto;
    }

    .floating-window.move * {
        cursor: grabbing !important;
    }

    .floating-window:not(.visible) {
        display: none;
    }

    .jonsole--content {
        background-color: var(--altbg) !important;
        font-family: "Commit Mono", monospace;
        width: 500px;
        height: 250px;
    }

    .jonsole--content * {
        padding: 0 !important;
    }

    .browser--content {
        height: 400px;
        width: 600px;
    }

    .browser--content iframe {
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: 0;
        max-width: initial !important;
    }

    .select-container {
        display: grid;
        grid-template-columns: repeat(3, minmax(6px, 1fr));
        gap: 12px;
    }

    .select-container .select {
        flex-grow: 1;
        padding: 6px;
        background-color: var(--bg);
        cursor: pointer;
        font-family: var(--font);
    }

    .select-container .select:hover {
        background-color: var(--altbg);
    }

    .select-container .select.selected {
        background-color: var(--acc);
    }

    .select-container .select .color-preview {
        display: grid;
        grid-template-columns: repeat(7, minmax(6px, 1fr));
        gap: 3px;
    }

    .select-container .select .color-preview div {
        margin-top: 6px;
        height: 20px;
        background-color: var(--cl);
    }

    @media screen and (width <= 640px) {
        .floating-window {
            top: 0;
            left: 0;
            max-height: 100dvh;
        }
    }
</style>
