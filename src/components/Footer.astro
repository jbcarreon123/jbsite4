---
import { version } from "../../package.json";
import { Image } from "astro:assets";
const hash = import.meta.env.COMMIT_HASH ?? "undefined";
---

<footer transition:persist transition:animate="none">
    <div class="sec">
        <a id="to-top" href="#">
            <p>Back to top</p>
        </a>
        <slot />
        <p class="small">
            jbsite4/<span set:html={hash} /> © 2025 jbcarreon123. Licensed under GNU
            AGPLv3.
        </p>
        <p class="small">
            Site content are licensed under CC BY-SA 4.0 unless specified.
        </p>
        <p class="small">Made in Astro and Node, hosted in jb's own server</p>
        <p class="small">
            <a href="https://maxpixels.moe/manifesto/" target="_blank"
                >Copying is an act of theft, while taking inspiration is the
                true act of love. <span
                    aria-hidden="true"
                    class="ms"
                    data-icon="open_in_new"></span></a
            >
        </p>
        <p class="small">Tip: Use CTRL+K to use search</p>
    </div>
    <div class="right">
        <a
            target="_blank"
            rel="noopener"
            class="w-fit shrink-0"
            href="https://developer.mozilla.org/en-US/docs/Web/SVG/SVG_animation_with_SMIL"
        >
            <Image
                src="/imgs/buttons/smil.svg"
                alt="Enhanced with SMIL :D"
                title="Enhanced with SMIL :D"
                width="88"
                height="31"
            />
        </a>
        <a
            target="_blank"
            rel="noopener"
            class="w-fit shrink-0"
            href="https://www.abuseipdb.com/user/287797"
        >
            <img
                src="https://www.abuseipdb.com/contributor/287797.svg"
                alt="AbuseIPDB Contributor Badge"
                style="width: 88px;border-radius: 5px; border-top: 5px solid #058403; border-right: 5px solid #111; border-bottom: 5px solid #111; border-left: 5px solid #058403; padding: 5px;background: #35c246 linear-gradient(rgba(255,255,255,0), rgba(255,255,255,.3) 50%, rgba(0,0,0,.2) 51%, rgba(0,0,0,0)); padding: 5px;"
            />
        </a>
        <a
            target="_blank"
            class="w-fit shrink-0"
            href="https://kalechips.net/responsive/index"
        >
            <Image
                src="/imgs/buttons/responsive-web-directory.png"
                alt="Responsive Web Directory"
                title="Responsive Web Directory"
                width="88"
                height="31"
            />
        </a>
        <a
            target="_blank"
            class="w-fit shrink-0"
            href="https://pinkvampyr.leprd.space/accessiblenet/index.php"
        >
            <Image
                src="/imgs/buttons/accessible-net.webp"
                alt="Accessible Net Directory"
                title="Accessible Net Directory"
                width="88"
                height="31"
            />
        </a>
    </div>
</footer>

<style scoped>
    @media screen and (width <=640px) {
        footer {
            flex-direction: column;
        }

        .right {
            display: grid;
            grid-template-columns: repeat(2, 88px);
            margin-inline: auto;
            width: auto;
            padding-top: 12px;
        }
    }
</style>

<script
    is:inline
    defer
    src="https://alyt.jbc.lol/script.js"
    data-website-id="4a271cd4-190d-4105-8f55-2bb322627aac"></script>
