---
import "../styles/fa-brands.css";
const { title, id, description } = Astro.props;
const { url, site } = Astro;
const ogImage =
    "https://" +
    url.hostname +
    "/imgs/og" +
    (url.pathname === "/" ? "/index" : url.pathname).replace(/\/$/, "");
import { ClientRouter } from "astro:transitions";
---

<meta charset="UTF-8" />
<link rel="prefetch" href="https://postreq.jbc.lol/postreq" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<title>{title ? title : "jb's site"}</title>
<meta name="description" content={description} />
<meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content="#00ffea"
/>
<meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content="#a4b6fd"
/>

<script>
    import { POSTreq } from "postreq";
    import { waitUntil } from 'async-wait-until';

    async function waitForPt() {
        const pt = new POSTreq()

        // @ts-ignore
        window.fetch = async (a, b) => {
            await waitUntil(() => pt.loaded, { timeout: 60000 });   
            const res =  await pt.fetch(a.toString(), b);
            console.debug(a, res);
            return res
        };
    }

    if (window.location.hostname.includes('neocities')) {
        waitForPt();
    }
</script>

<style>
    @font-face {
        font-family: Inter;
        src: url(/fonts/Inter-Variable.ttf);
        src: url(/fonts/InterVariable.woff2);
        font-weight: 100 900;
        font-display: swap;
        font-style: normal;
    }

    @font-face {
        font-family: Inter;
        src: url(/fonts/InterVariable-Italic.woff2);
        font-weight: 100 900;
        font-display: swap;
        font-style: italic;
    }

    @font-face {
        font-family: Sheepish;
        src: url(/fonts/Sheepish-Regular.ttf);
        font-display: swap;
        size-adjust: 125%;
        line-height-override: 75%;
    }

    @font-face {
        font-family: Sheepish SC;
        src: url(/fonts/SheepishSmallCaps-Regular.ttf);
        font-display: swap;
        size-adjust: 125%;
        line-height-override: 75%;
    }

    @font-face {
        font-family: Atkinson Hyperlegible;
        size-adjust: 70%;
        line-gap-override: 50%;
        src: url(/fonts/Atkinson-Hyperlegible-Regular.woff2);
        font-display: swap;
    }

    @font-face {
        font-family: Boxy;
        src: url(/fonts/Boxy.woff2);
        font-display: swap;
    }

    @font-face {
        font-family: Dann Inc;
        src: url(/fonts/DannInc.ttf);
        font-display: swap;
    }

    @font-face {
        font-family: Commit Mono;
        src: url(/fonts/CommitMono-Variable.ttf);
        font-display: swap;
    }

    @font-face {
        font-family: OpenDyslexic;
        src: url(/fonts/OpenDyslexic-Regular.woff2);
        font-display: swap;
    }

    @font-face {
        font-family: "VCR OSD Mono";
        src: url(/fonts/VCR-OSD-Mono.ttf);
        font-display: swap;
    }

    @font-face {
        font-family: Material Symbols;
        src: url(/fonts/MaterialSymbols.woff2);
        font-display: block;
    }
</style>

<!-- Meta tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta
    property="og:type"
    content={url.pathname.includes("posts") ? "article" : "website"}
/>
<meta property="twitter:image" content={ogImage + ".avif"} />

<!-- Alternate links -->
<link
    rel="alternate"
    type="application/rss+xml"
    title="jb's posts"
    href={new URL("feed.xml", new URL(Astro.url))}
/>
<link
    rel="alternate"
    type="application/atom+xml"
    title="jb's posts"
    href={new URL("feed.atom", new URL(Astro.url))}
/>
<link
    rel="alternate"
    type="application/json"
    title="jb's posts"
    href={new URL("feed.json", new URL(Astro.url))}
/>
<link rel="me" href="https://fosstodon.org/@jbcarreon123" />
<link rel="canonical" href={"https://jbc.lol" + new URL(Astro.url).pathname} />

<!-- Scripts and stuff -->
<!-- <ClientRouter /> -->

<script is:inline>
    let cLog = console.log;
    console.log = (message, ...params) => {
        if (typeof message === "string" && message.includes("%c")) {
            msg = message;
            message = params[1] ?? " ";
            let tg1 = params.shift();
            cLog(
                `%cjbsite4%c ${msg}`,
                "background: #0084ff; color: white; padding-inline: 4px; border-radius: 2px; font-family: monospace;",
                "background: initial; color: initial;",
                tg1,
                message,
                ...params,
            );
        } else {
            cLog(
                `%cjbsite4`,
                "background: #0084ff; color: white; padding-inline: 4px; border-radius: 2px; font-family: monospace;",
                message,
                ...params,
            );
        }
    };

    let cErr = console.error;
    console.error = (message, ...params) => {
        cErr(
            `%cjbsite4`,
            "background: #ff2424; color: white; padding-inline: 4px; border-radius: 2px; font-family: monospace;",
            message,
            ...params,
        );
    };

    Array.prototype.sample = function () {
        return this[Math.floor(Math.random() * this.length)];
    };

    function load() {
        let v = window.scrollY;
        document.querySelector("#main")?.scrollIntoView();
        window.scroll(window.scrollX, v);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const inIframe = window.self !== window.top;
        if (inIframe && !window.location.href.includes('/frame/')) {
            createNotif(
                "You are visiting jb's site in an iframe!",
                "For full experience, I recommend you to visit my site on not an iframe.",
            );
        }

        if (
            window.location.host !== "jbc.lol" &&
            window.location.hostname !== "localhost"
        ) {
            if (
                window.location.host === "local.jbc.lol" ||
                window.location.host.includes("github.dev")
            ) {
                createNotif(
                    "You are visiting jb's site preview!",
                    "This contains some things that isn't on the main site yet!",
                );
            } else {
                const showed = sessionStorage.getItem("jbsite:previewShowed");
                if (!showed) {
                    createNotif(
                        "You are visiting jb's site on a backup host!",
                        "Note that some things that I only focused on the main host, jbc.lol, will break. Especially webrings.",
                    );
                    sessionStorage.setItem("jbsite:previewShowed", "true")
                }
            }
        }

        // window.addEventListener("error", (e) => {
        //     createNotif("An error occurred.", `${e.error.message}\n\nI recommend refreshing your browser.`);
        // })

        // window.addEventListener("unhandledrejection", (e) => {
        //     createNotif("An error occurred.", `${e.reason.message}\n\nI recommend refreshing your browser.`);
        // })

        let headerMenu = document.querySelector("header a");
        if (headerMenu)
            headerMenu.addEventListener("click", (e) => {
                e.preventDefault();

                let sidebar = document.getElementById("sidebar");
                let main = document.getElementById("main");

                if (sidebar.classList.contains("visible")) {
                    sidebar.classList.remove("visible");
                    main.scrollIntoView();
                } else {
                    sidebar.classList.add("visible");
                    sidebar.scrollIntoView();
                }
            });

        if (window.matchMedia("(width <= 890px)").matches)
            setTimeout(
                () => document.querySelector("main")?.scrollIntoView(),
                50,
            );

        const asideElement = document.querySelector("aside");
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const asideRect = entry.boundingClientRect;
                        const rootRect = entry.rootBounds || {
                            width: window.innerWidth,
                        };

                        if (
                            asideRect.left >= rootRect.left &&
                            asideRect.right <= rootRect.right
                        ) {
                            sidebar.classList.add("visible");
                        } else {
                            sidebar.classList.remove("visible");
                        }
                    } else {
                        sidebar.classList.remove("visible");
                    }
                });
            },
            {
                root: null,
                rootMargin: "150px",
                threshold: 1,
            },
        );
        observer.observe(asideElement);
    });
    document.addEventListener("DOMContentLoaded", () => load());

    document.addEventListener("DOMContentLoaded", () => {
        console.log(
            "%cSTOP!",
            "color: red; font-size: 64px; font-weight: bold;",
        );
        console.log(
            "%cDo NOT paste anything here unless you understand exactly what it does!",
            "color: white; background-color: red; font-size: 24px; font-weight: bold; border-radius: 3px;",
        );
        console.log(
            "%cPasting something here that you don't know how it works, can lead to your Nekoweb cookie being stolen!",
            "color: orange; font-size: 18px; font-weight: bold",
        );
        console.log(
            "%cIf someone asked you to paste something here, they are likely trying to hijack your account!",
            "color: red; font-size: 18px; font-weight: bold; background-color: black; border-radius: 3px;",
        );
        console.log("\n\n");
        console.log(
            "%c👍 Only paste code from sources you fully trust and understand.",
            "color: green; font-size: 16px; font-weight: bold;",
        );
        console.log(
            "%c🔒 Remember: Security is YOUR responsibility.",
            "color: yellow; font-size: 16px; font-weight: bold;",
        );

        document.querySelector("#to-top").addEventListener("click", (e) => {
            e.preventDefault();
            document.querySelector("main>div").scroll({
                top: 0,
                left: 0,
                behavior: "smooth",
            });
        });
    });
</script>

<script>
    import { Analytical } from "../lib/analytical.ts";

    const analytical = new Analytical();
    analytical.pageLoad(new URL(location.href));
</script>

<noscript>
    <style>
        /* weirdest way to force specificity lmao */
        div.jsreq.jsreq.jsreq.jsreq.jsreq {
            display: none;
        }

        a.jsreq::after {
            content: " [JS]";
            font-size: 0.75em;
        }

        webring-test-results::after, astro-island[component-url="/_astro/CommentWidget.BIDwo4x3.js"]::after {
            display: block;
            content: 'JavaScript is disabled. Please enable JS to see Webring Test Results component.';
            padding: 12px;
            background: var(--altbg);
            margin-top: 5px;
        }

        astro-island[component-url="/_astro/CommentWidget.BIDwo4x3.js"]::after {
            content: 'To see comments, enable JavaScript.';
        }
    </style>
</noscript>

<style is:inline id="customCSS"></style>
