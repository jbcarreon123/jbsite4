---
import { loadMusic } from "../lib/loadMusic";
import { fromPath } from '@catamphetamine/id3js/node';
import PlayerContainer from 'jplayer3';

const music = await loadMusic();
---

<div class="floating-window" id="player" style="display: none;">
    <div class="floating-window-titlebar">
        <p>jPlayer3</p>
        <p onclick="closeWindow(this)"><span aria-hidden="true" class="ms" data-icon="close"></span></p>
    </div>
    <div class="floating-window-content">
        <PlayerContainer client:load id="player" tracks={JSON.stringify(music.map(m => ({ url: '/music/' + m })))} />
    </div> 

    <style>
        .floating-window {
            width: 75dvw;
            max-width: 850px;
        }

        @media screen and (width <= 640px) {
            .floating-window {
                width: 100%;
            }
        }
    </style>
</div>