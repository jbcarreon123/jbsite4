<html lang="en" class="inter" data-color="dark">
	<head>
		<CommonHead title={title} id={id} description={description} />
		<slot name="head">
	</head>
	<body class="">
		<h1 class="style-broken">If you're seeing this, please hard reload. You can do it by using CTRL+SHIFT+R or SHIFT+F5.</h1>
		<NotifModal />
		<RichTooltip />
		<ImageViewer />
		<JumpToContent />
		
		<div class="container" transition:animate="none">
			<Sidebar title={title} id={id} description={description}>
				<slot name="toc" />
			</Sidebar>
			<main id="main">
				<header>
					<a href="#sidebar"><span
						aria-hidden="true"
						class="ms" data-icon="menu"></span
					> Menu</a>
					<p class="page-title">{title ? title : "jb's site"}</p>
				</header>
				<div>
					<div id="content" transition:animate="slide" style={Astro.props.style}>
						<slot />
					</div>	
					<Footer />
				</div>
			</main>
		</div>
		<div transition:persist>
			<Windows />
		</div>
	</body>
</html>
