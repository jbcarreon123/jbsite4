---
import '@csstools/normalize.css';
import "../styles/global.css";

const { title, id, description } = Astro.props;

import Windows from "../components/Windows.astro";
import CommonHead from "../components/CommonHead.astro";
import Sidebar from "../components/Sidebar.astro";
import FpsMeter from "../components/FpsMeter.svelte";
import RichTooltip from "../components/RichTooltip.astro";
import NotifModal from "../components/NotifModal.astro";
import ImageViewer from '../components/ImageViewer.astro';
import Search from '../components/Search.svelte';
import JumpToContent from '../components/JumpToContent.astro';
import Footer from '../components/Footer.astro';

---

<!doctype html>
<!--

     ▘▌ ▌      ▘▗              ▘      ▖▖
     ▌▛▌ ▛▘  ▛▘▌▜▘█▌▖  ▌▌█▌▛▘▛▘▌▛▌▛▌  ▙▌
     ▌▙▌ ▄▌  ▄▌▌▐▖▙▖▖  ▚▘▙▖▌ ▄▌▌▙▌▌▌   ▌
    ▙▌                                  

    Copyright (c) 2024-2025 JB Carreon.

    This website is distributed under GNU AGPLv3.
    See https://git.gay/jbcarreon123/jbsite4/src/branch/dev/LICENSE
    for more info.

    SPDX-License-Identifier: AGPL-3.0
    
-->
<html lang="en" class="inter" data-color="dark">
	<head>
		<CommonHead title={title} id={id} description={description} />
		<slot name="head">
	</head>
	<body class="">
		<div class="topbar">
			<img src="x" style="display: none;" onerror="(()=>{if (localStorage.getItem('ann:cnt') || localStorage.getItem('ann:nkz:rm') || document.referrer == 'docs.google.com') this.parentElement.remove()})()">
			<button onclick="(()=>{this.parentElement.remove(); localStorage.setItem('ann:nkz:rm', 'true')})()">X</button>
			<p class="tg">Announcements</p>
			<h2><a href="https://zine.nekoweb.org" target="_blank">NEKOZINE and merch preorders are out!</a></h2>
			<p>Get yours at ZINE.nekoweb.org! <i>(psst. i participated there!)</i></p>
		</div>
		<div class="topbar cnt">
			<img src="x" style="display: none;" onerror="(()=>{if (localStorage.getItem('ann:cnt:rm') || (document.referrer !== 'docs.google.com' && !sessionStorage.getItem('ann:cnt'))) this.parentElement.remove(); else sessionStorage.setItem('ann:cnt', 'true')})()">
			<button onclick="(()=>{this.parentElement.remove(); localStorage.setItem('ann:cnt:rm', 'true')})()">X</button>
			<p class="tg">Announcements</p>
            <h2>Hello from Petra's Indie Web Contest!</h2>
			<p>I hope you enjoyed visiting jb's site!</p>
		</div>
		<h1 class="style-broken">If you're seeing this, please hard reload. You can do it by using CTRL+SHIFT+R or SHIFT+F5.</h1>
		<FpsMeter client:only="svelte" />
		<NotifModal />
		<RichTooltip />
		<ImageViewer />
		<Search client:load />
		<JumpToContent />
		
		<div class="container" transition:animate="none">
			<Sidebar title={title} id={id} description={description}>
				<slot name="toc" />
			</Sidebar>
			<main id="main" transition:animate="fade">
				<header>
					<a href="#sidebar"><span
						aria-hidden="true"
						class="ms" data-icon="menu"></span
					> Menu</a>
					<p class="page-title">{title ? title : "jb's site"}</p>
				</header>
				<div>
					<div id="content" style={Astro.props.style}>
						<slot />
					</div>	
					<Footer><slot name="footer"></slot></Footer>
				</div>
			</main>
		</div>
		<div transition:persist>
			<Windows />
		</div>
	</body>
</html>
