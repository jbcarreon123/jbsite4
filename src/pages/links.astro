---
import Layout from '../layouts/Layout.astro';
import Buttons from '../components/SiteButtons.astro'
import { linksStuff } from '../lib/linksstuff';
import { Code } from 'astro-expressive-code/components';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

const sitebtns = [
    '<a href="https://jbc.lol"><img src="https://jbc.lol/imgs/buttons/jbtn.svg" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
    '<a href="https://jbc.lol"><img src="https://jbc.lol/imgs/buttons/jbtn.gif" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
    '<a href="https://jbc.lol"><img src="https://jbc.lol/imgs/buttons/jbtn.png" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
    '<a href="https://jbc.lol"><img src="https://jbc.lol/sitebutton3.png" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
    '<a href="https://jbc.lol"><img src="https://jbc.lol/sitebutton2.png" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
];

const oldsitebtns = [
    '<a href="https://jbc.lol"><img src="https://jbc.lol/sitebutton.png" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
    '<a href="https://jbc.lol"><img src="https://jbc.lol/sitebuttonv2.png" alt="jb\'s site" style="image-rendering: pixelated;"/></a>',
]
---

<Layout title="Links" id="links" description="other links">
    <h1>Links</h1>
    <p>Links to other sites, webrings, and more!</p>
    <p>Note that this might get laggy as this contains a lot of JS.</p>

    <h2>My buttons (hotlink ok!)</h2>
    <p class="small">tip: drag the button into your text editor. have fun!</p>
    <p>jbSite4 and neutral styled buttons</p>
    <div id="jbuttons">
        {sitebtns.map((btn) => <div>
            <div set:html={btn.replaceAll('https://jbc.lol/', '/')}></div>
            <Code code={btn} lang="html" />
        </div>)}
    </div>
    <p>jbSite3 styled buttons</p>
    <div id="jbuttons">
        {oldsitebtns.map((btn) => <div>
            <div set:html={btn.replaceAll('https://jbc.lol/', '/')}></div>
            <Code code={btn} lang="html" />
        </div>)}
    </div>

    <h2>Other sites</h2>
    <p>This is loaded from a JSON file, so you can just fetch /buttons.json if you want lol</p>
    <Buttons />

    <h2>Other Projects and stuff</h2>
    <div class="projs">
        {linksStuff.map((link) => <a href={link.url} data-tooltip-data={
                `${link.author ? `<p class="tg">${link.author}</p>` : ''}<h2>${link.name}</h2><p>${link.description}</p>${link.tags ? `<p class="tg"><span class="ms" aria-hidden="true" data-icon="sell"></span> ${link.tags.join(' ')}</p>` : ''}`
            }>
            {link.button ? <img src={link.button} alt={link.name} /> : <p>{link.name}</p>} 
        </a>)}
    </div>

    <h2>Cliques</h2>
    <p>soon...</p>

    <h2>Webrings</h2> 
    <p>Webrings are moved to <a href="/webrings/" data-astro-reload>/webrings</a>.</p>

    <h2>...links</h2>
    <div id="linksiframe">
        <div>
            <div>
                <iframe
                    title="nekolink"
                    loading="lazy"
                    style="border:none;"
                    src="https://rubybulbs.net/neko.html"
                ></iframe>
            </div>
        </div>
        <div>
            <div>
                <iframe style="border:none" class="aspect-square max-h-2xs w-full max-w-2xs" src="https://dimden.neocities.org/navlink/" title="neolink"></iframe>
            </div>
        </div>
        <div>
            <div>
                <iframe style="border:none" src="https://evehibi.nekoweb.org/ringlink/" name="ringlink"></iframe>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelector("#jbuttons > div")?.querySelectorAll("a").forEach((el) => {
                el.addEventListener("dragstart", (e) => {
                    e.dataTransfer?.clearData(); 
                    (e.target as HTMLElement).removeAttribute('data-alyt-event');
                    e.dataTransfer?.setData("text/plain", (e.target as HTMLElement).outerHTML.replaceAll('="/', '="https://jbc.lol/'));
                    e.dataTransfer?.setData("text/html", (e.target as HTMLElement).outerHTML);
                    (e.target as HTMLElement).dataset.alytEvent = "true";
                })
            })
        })
    </script>

    <style is:inline>
        .projs {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 6px;
        }

        #jbuttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(100px, 1fr));
            gap: 6px;
            &>* {
                background-color: var(--acc);
                padding: 6px;
            }
        }

        #linksiframe {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }

        iframe {
            width: 100% !important;
        }

        #linksiframe > div {
            background-color: var(--acc);
            padding: 12px;
        }

        #linksiframe iframe {
            aspect-ratio: 1/1;
            width: 100%;
        }

        #linksiframe div div {
            margin: 0 auto;
            text-align: center;
        }

        @media screen and (width <= 640px) {
            #linksiframe {
                grid-template-columns: repeat(1, 100%);
            }
            
            #linksiframe iframe {
                width: clamp(60px, 100%, 256px);
            }
        }
    </style>
</Layout>