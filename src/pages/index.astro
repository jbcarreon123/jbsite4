---
import Layout from "../layouts/BgOnlyLayout.astro";
import TabbedSvelte from "../components/Tabbed.svelte";
---

<Layout title="welcome to jb's site" id="welcome">
    <div class="center">
        <div class="mock-page1">
            <div class="mock-sidebar"></div>
        </div>
    </div>
    <div class="welcome-container">
        <section class="greeting-container">
            <div class="greeting">
                <h1 class="big inter force-font">
                    <p class="sheepish force-font">welcome to</p>
                    <span style="--d:000ms;">j</span><span style="--d:100ms;"
                        >b</span
                    ><span style="--d:200ms;">'</span><span style="--d:300ms;"
                        >s</span
                    >
                    <span style="--d:500ms;">s</span><span style="--d:600ms;"
                        >i</span
                    ><span style="--d:700ms;">t</span><span style="--d:800ms;"
                        >e</span
                    >
                </h1>
            </div>
            <div>
                <p class="tg">CONTENT WARNING</p>
                <div class="warning">
                    <img src="/imgs/landing/rating_ma.gif" alt="" />
                    <h2>This page is rated 16+</h2>
                    <p>
                        Can contain moderate cursing, and some opinions children
                        shouldn't see
                    </p>
                </div>
            </div>
        </section>
        <div class="tc"><p class="tg">Popular All-seasons</p></div>
        <section>
            <a class="box-container" href="/utils/nekobox/">
                <img
                    src="/imgs/nekobox/icon-256.png"
                    style="width: 150px; max-height: 150px;right: -32px;bottom:-32px;--r:-24px;--b:-16px;"
                    alt=""
                />
                <p>Now installable via PWA!</p>
                <h2>Nekobox</h2>
            </a>
            <a class="box-container" href="https://postrequest.neocities.org/">
                <img
                    src="/imgs/landing/postreq.png"
                    style="width: 120px;bottom:-24px;"
                    alt=""
                />
                <p></p>
                <h2>POSTreq</h2>
            </a>
        </section>
        <div class="tc"><p class="tg">Site Stuff</p></div>
        <section>
            <a class="box-container" href="/posts/">
                <img src="/imgs/landing/posts.png" alt="" />
                <p></p>
                <h2>Posts</h2>
            </a>
            <a class="box-container" href="/tutorials/">
                <p></p>
                <h2>Tutorials</h2>
                <img src="/imgs/landing/tutorials.png" alt="" />
            </a>
            <a class="box-container" href="/about/">
                <p></p>
                <h2>About JB</h2>
                <img
                    src="/imgs/landing/about.png"
                    style="filter:brightness(150%)"
                    alt=""
                />
            </a>
            <a class="box-container" href="/links/">
                <img src="/imgs/landing/links.png" alt="" />

                <p></p>
                <h2>Links</h2>
            </a>
        </section>
        <div class="tc"><p class="tg">Socials</p></div>
        <section class="nested">
            <div class="box-container welcome-container2">
                <a class="box-container" href="https://waf.moe/blog/jb">
                    <img
                        src="/imgs/landing/waffy.png"
                        style="bottom: -4px"
                        alt=""
                    />
                    <img src="/imgs/landing/fedi.png" alt="" class="left" />
                    <h3>@jb@waf.moe</h3>
                </a>
                <a
                    class="box-container"
                    href="https://bsky.app/profile/jbc.lol"
                >
                    <img src="/imgs/landing/bsky.png" alt="" />
                    <img src="/imgs/landing/atproto.png" alt="" class="left" />
                    <h3>@jbc.lol</h3>
                </a>
            </div>

            <div
                class="box-container welcome-container2 ct3"
                style="justify-content: end;"
            >
                <a class="box-container" href="/webrings/">
                    <img
                        src="/imgs/landing/webrings.png"
                        style="height: 100px"
                        alt=""
                    />
                    <h3>Webrings</h3>
                </a>
                <a class="box-container index" href="/home/">
                    <img src="/imgs/landing/main.png" alt="" />
                    <h3>Enter jb's site</h3>
                </a>
            </div>
        </section>
    </div>

    <div class="indieweb" style="display: none;">
        <!-- IndieWeb Webring: all my webrings are on /webrings -->

        <a href="https://xn--sr8hvo.ws/previous">←</a>
        An <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a> 🕸💍
        <a href="https://xn--sr8hvo.ws/next">→</a>

        <!-- h-card: done this because I need to format my site properly before I can properly use h-card -->

        <div class="h-card">
            <span class="p-name">John Benedict Carreon</span>
            <span class="p-given-name">John Benedict</span>
            <span class="p-family-name">Carreon</span>
            <span class="p-nickname">Jb</span>
            <a class="u-url" href="http://jbc.lol">w</a>,
            <a class="u-email" href="mailto:jb@jbc.lol">@</a>
            <div class="p-country-name">Philippines</div>
            <time class="dt-bday">04-2008</time>
        </div>
    </div>

    <style>
        body:has(.shaking) {
            pointer-events: none;
            overflow: hidden;
        }

        body:has(.shaking2) .center {
            position: fixed;
            inset: 0;
            opacity: 1;
            z-index: 5;
            background-color: var(--altbg);

            .mock-page1 {
                max-width: 1000px;
                margin-inline: auto;
                height: 100%;
                background-color: var(--bg);

                .mock-sidebar {
                    width: 200px;
                    height: 100%;
                    background-color: var(--acc);
                }
            }
        }

        .welcome-container {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding-block: 24px;
            padding-inline: 24px;
            max-width: 800px;
            margin-inline: auto;
            min-height: 100dvh;
            justify-content: center;

            & > section {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                align-items: center;

                & > div,
                & > a {
                    display: flex;
                    flex-direction: column;
                }
            }
        }

        .warning,
        .box-container {
            position: relative;
            background: var(--acc);
            padding: 6px;
            padding-right: 54px;
            overflow: hidden;

            & > * {
                position: relative;
            }

            img {
                position: absolute;
                bottom: -12px;
                right: -12px;
                width: 90px;
                max-height: 120px;
                object-fit: contain;
                transform: rotate(-15deg);
                opacity: 0.75;
                pointer-events: none;
            }

            &:not(:has(.box-container)):hover img:not(.left) {
                bottom: var(--b, 0) !important;
                right: var(--r, 0) !important;
            }

            img.left {
                right: initial;
                left: -6px;
                bottom: -6px;
                width: 40px;
                transform: rotate(15deg);
            }
        }

        .box-container {
            height: 100%;
            min-height: 120px;
            vertical-align: bottom;
            color: var(--text);
            align-items: start !important;

            p {
                height: 100%;
            }

            &:hover {
                background-color: var(--bg);
            }

            h2 {
                padding-bottom: 0;
            }
        }

        .welcome-container2 {
            background-color: transparent;
            display: flex;
            flex-direction: row !important;
            gap: 12px;
            padding: 0;
            overflow: visible;

            &:hover {
                background-color: transparent;
            }

            & > a {
                aspect-ratio: 1 / 1;
                max-width: 150px;
                padding-right: 6px;
            }
        }

        .ct3 {
            & > a:last-child {
                flex-basis: 0;
                flex-grow: 1;
                width: 100%;
                max-width: initial;
                max-height: 150px;
                aspect-ratio: initial;
            }
        }

        .tc {
            position: relative;
        }

        .tc .tg {
            position: absolute;
            margin-bottom: 0;
        }

        .greeting {
            position: relative;
            justify-content: end;
            height: 100%;
        }

        .sheepish {
            position: absolute;
            z-index: 1;
            transform: rotate(-10deg);
            text-shadow: 1px 1px 1px black;
            top: -8px;
            left: -24px;
            font-size: 0.3em;
        }

        .big {
            position: relative;
            z-index: 0;
            font-size: 4em;
            margin-left: 24px;
        }

        .big span {
            position: relative;
            display: inline-block;
            color: var(--anim-color1);
        }

        .big span:nth-of-type(odd) {
            animation:
                title 2000ms var(--d) infinite alternate,
                transform 2000ms var(--d) infinite alternate ease-in-out;
            top: -6px;
        }

        .big span:nth-of-type(even) {
            animation:
                title 2000ms var(--d) infinite alternate,
                transform 2000ms var(--d) infinite alternate-reverse ease-in-out;
            top: 6px;
        }

        .shaking {
            animation: shaking 1s forwards ease-in;
            & > * {
                opacity: 0 !important;
            }

            transition: opacity 2500ms 0.5s ease-in-out;
            opacity: 0;
            z-index: 25;
        }

        @keyframes title {
            from {
                color: var(--anim-color1);
            }
            to {
                color: var(--anim-color2);
            }
        }

        @keyframes transform {
            0% {
                top: -6px;
            }
            80% {
                top: 6px;
            }
        }

        @keyframes shaking {
            from {
                transform: none;
            }
            to {
                transform: scale(200);
            }
        }

        @media screen and (width <= 450px) {
            section,
            .welcome-container2 {
                grid-template-columns: 1fr !important;

                div,
                a {
                    padding-right: 6px !important;
                }
            }
        }

        h3 {
            margin: 0;
            padding: 0;
        }

        @media screen and (width <= 730px) {
            .greeting-container,
            .nested {
                grid-template-columns: 1fr !important;
            }

            img {
                opacity: 0.5 !important;
            }

            .sheepish {
                top: 0;
            }

            .welcome-container2 {
                display: grid !important;
                grid-template-columns: 1fr 1fr;
                & > a {
                    aspect-ratio: initial !important;
                    width: 100%;
                    max-width: initial;
                }
            }
        }
    </style>
</Layout>
