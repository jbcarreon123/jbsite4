---
import Contact from "../components/Contact.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="About JB" description="about this fella" id="about">
    <h1>About me</h1>
    <div class="card">
        <p>
            Hi there! I'm JB, the webbed master of this webbed site! I'm a 17
            year old Filipino that does something on my free time! I loved the
            indie web as it shows the creativity of each person and lets them
            have fun!
        </p>
        <p>
            I enjoy coding something, listening to music, chatting and helping
            people!
        </p>

        <div class="about-buttons">
            <img src="/imgs/id/male.avif" alt="Male" />
            <img src="/imgs/id/He_Him_They.avif" alt="He/Him/They" />
            <img src="/imgs/id/filipino.avif" alt="Filipino" />
            <img
                src="/imgs/id/eng_second_lang.avif"
                alt="English is my second and preferred language!"
            />
            <img src="/imgs/id/left_handed.avif" alt="Left-handed" />
            <img src="/imgs/id/rat.avif" alt="Year of the Rat" />
        </div>
    </div>

    <h1>What am I enjoying right now?</h1>
    <div class="card">
        <p>
            Coding my site and the things around it, it's really fun doing it
            and having feedback about it
        </p>
        <p>
            I love to watch YouTube videos, and YouTube is recommending me so much
            stuff I want to see! <i>also i guess im on the furry fandom now</i>
        </p>
        <p>
            Helping people is also fun, I really enjoy helping people and see
            that it fixes their problem
        </p>
        <p>
            And also lastly, walking (but I do not enjoy the high heats here in
            the PH)
        </p>
    </div>

    <h1 class="mt-4">My system specs</h1>
    <div id="specs">
        <div class="card">
            <h2>Main system (laptop)</h2>
            <table>
                <tbody>
                    <tr>
                        <td>Model</td>
                        <td>Lenovo LOQ 15IAX9</td>
                    </tr>
                    <tr>
                        <td>CPU</td>
                        <td>Core i5-13450HX</td>
                    </tr>
                    <tr>
                        <td>GPU</td>
                        <td
                            >Nvidia RTX 3050 6GB Mobile Refresh + Intel UHD
                            Graphics</td
                        >
                    </tr>
                    <tr>
                        <td>RAM</td>
                        <td>20GB DDR5-4800</td>
                    </tr>
                    <tr>
                        <td>OS</td>
                        <td>EndeavourOS / Windows 11</td>
                    </tr>
                    <tr>
                        <td>Storage</td>
                        <td>512GB SSD + 256GB SSD</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card">
            <h2>The Shitbox (second system)</h2>
            <table>
                <tbody>
                    <tr>
                        <td>Model</td>
                        <td>Dell Vostro 270s</td>
                    </tr>
                    <tr>
                        <td>CPU</td>
                        <td>Core i3-2100</td>
                    </tr>
                    <tr>
                        <td>GPU</td>
                        <td>Intel HD Graphics</td>
                    </tr>
                    <tr>
                        <td>RAM</td>
                        <td>8GB DDR3-1333</td>
                    </tr>
                    <tr>
                        <td>OS</td>
                        <td>EndeavourOS</td>
                    </tr>
                    <tr>
                        <td>Storage</td>
                        <td>128GB SSD</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <style is:inline>
        img {
            image-rendering: pixelated;
            position: relative;
            z-index: 2;
        }

        img:hover {
            z-index: 50;
            transform: scale(1.25);
            filter: blur(0);
        }

        .about-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .about-buttons:has(img:hover) img:not(:hover),
        #albums:has(img:hover) img:not(:hover) {
            z-index: 1;
            opacity: 0.5;
            filter: blur(1px);
        }

        tr td:first-child {
            width: 80px;
        }

        tr td:last-child {
            padding-left: 8px;
        }

        #albums img {
            width: 128px;
            height: auto;
        }

        #specs,
        .cards {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
        }

        .cards .col {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .card {
            padding: 6px;
            background: var(--acc);
        }

        .card.contact {
            margin-top: 6px;
        }

        .card h2 {
            padding-top: 0;
        }

        .card ul {
            margin-left: 0;
        }

        @media screen and (width <= 640px) {
            #specs,
            .cards {
                grid-template-columns: repeat(1, 100%);
            }
        }
    </style>
</Layout>
