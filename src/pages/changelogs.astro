---
import util from 'util';
import { exec } from "child_process";
import Layout from "../layouts/Layout.astro";

const execAsync = util.promisify(exec);
const {stdout, stderr} = await execAsync(`git log --pretty=format:'{ "hash": "%H", "shortHash": "%h", "treeHash": "%T", "parentHashes": "%P", "author": { "name": "%an", "email": "%ae", "date": "%ad" }, "committer": { "name": "%cn", "email": "%ce", "date": "%cd" }, "subject": "%s", "body": "%b" }' | jq -s '.'`);

console.log(stdout);
---

<Layout>
    <h1>jbsite4 Changelogs</h1>
    <p>Let's see if JB actually uses this</p>
</Layout>