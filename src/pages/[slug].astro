---
type PostModule = { url: string };

const posts = Object.values(import.meta.glob('./posts/**/*.md', { eager: true })) as PostModule[];
const tutorials = Object.values(import.meta.glob('./tutorials/**/*.md', { eager: true })) as PostModule[];

const slugs = posts.concat(tutorials).map((val) => {
    let path = val.url.replace(/\/$/, '').split('/');
    let slug = path[path.length - 1].split('-').map(x => x[0]).join('');
    return { path: path[path.length - 1], slug }
})

const { slug } = Astro.params;
const redirSlug = slugs.find(x => x.slug === slug)

if (!redirSlug) {
    return new Response(null, { status: 404 });
}

return new Response(null, {
    status: 301,
    headers: {
        Location: '/posts/' + redirSlug.path + '/'
    }
})
---
