---
type PostModule = { url: string };

const posts = Object.values(import.meta.glob('../posts/**/*.md', { eager: true })) as PostModule[];
const postSlugs = new Set(posts.map((val) => val.url.replace(/\/$/, '').split('/').pop()));

const { slug } = Astro.params;

if (!slug || !postSlugs.has(slug)) {
    return new Response(null, { status: 404 });
}

return new Response(null, {
    status: 301,
    headers: {
        Location: '/posts/' + slug + '/'
    }
})
---
