---
import Layout from "../layouts/BgOnlyLayout.astro";
import Bg from "../components/404bg.svelte";
---

<Layout title="404" id="404">
    <script>
        (async () => {
            let path = window.location.pathname;
            let url = new URL(path, "https://v3.jbc.lol");
            let res = await fetch(url);

            if (res.ok) {
                let found = document.querySelector(".found-on-v3");
                let link = found?.querySelector("a");
                found?.classList.add("yes");
                link.href = url;
            }
        })();
    </script>

    <Bg client:load />

    <style is:inline>
        * {
            user-select: none;
        }

        .found-on-v3 {
            padding-top: 12px;
        }

        .found-on-v3:not(.yes) {
            display: none;
        }

        .main {
            height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .diag {
            position: relative;
            z-index: 2;
            background-color: var(--bg);
            padding: 12px;
            width: fit-content;
            max-width: 800px;
        }
    </style>
</Layout>
